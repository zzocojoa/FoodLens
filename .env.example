# ============================================================
# FoodLens Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to Git.
# Related docs paths:
# - docs/roadmap/cloud-decision-record.md
# - docs/roadmap/phase-2-cloud-db-execution.md
# - docs/ops/db-cutover-local-to-render-postgres.md
# ============================================================

# --- AI Model ---
GEMINI_MODEL_NAME=gemini-2.5-flash
# 비용 상한 보호를 위해 기본 모델은 Flash 계열로 고정합니다.
GEMINI_MAX_CONCURRENT_SLOTS=2
GEMINI_RETRY_INITIAL_SECONDS=2.0
GEMINI_RETRY_MAX_SECONDS=30.0
GEMINI_RETRY_MULTIPLIER=2.0
GEMINI_RETRY_TIMEOUT_SECONDS=15.0
GEMINI_429_BACKOFF_INITIAL_SECONDS=0.5
GEMINI_429_BACKOFF_MULTIPLIER=2.0
GEMINI_429_COOLDOWN_SECONDS=20
GEMINI_429_COOLDOWN_MIN_CONSECUTIVE=4
UPSTREAM_429_RETRY_AFTER_SECONDS=15
GEMINI_LABEL_MODEL_NAME=gemini-2.5-flash
GEMINI_LABEL_FALLBACK_MODEL_NAME=gemini-2.5-flash-lite
GEMINI_LABEL_FALLBACK_ENABLED=0
GEMINI_LABEL_PRO_FALLBACK_ENABLED=0
GEMINI_LABEL_FALLBACK_ON_PARSE_ERROR=0
GEMINI_LABEL_FALLBACK_ON_MAX_TOKENS=0
GEMINI_LABEL_EXTRACT_MAX_OUTPUT_TOKENS=1536
GEMINI_LABEL_ASSESS_MAX_OUTPUT_TOKENS=768
GEMINI_BARCODE_ALLERGEN_MAX_OUTPUT_TOKENS=512
GEMINI_BARCODE_ALLERGEN_THINKING_BUDGET=0
GEMINI_FOOD_MAX_OUTPUT_TOKENS=4096
GEMINI_FOOD_RETRY_MAX_OUTPUT_TOKENS=6144
GEMINI_FOOD_MAX_OUTPUT_TOKENS_RETRY=6144

# --- API Edge Guard (Phase 4) ---
ANALYSIS_RATE_LIMIT_ENABLED=1
ANALYSIS_RATE_LIMIT_BACKEND=auto
ANALYSIS_RATE_LIMIT_TABLE=analysis_rate_limit_events
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60
ANALYSIS_RATE_LIMIT_ANALYZE_PER_MIN=15
ANALYSIS_RATE_LIMIT_LABEL_PER_MIN=15
ANALYSIS_RATE_LIMIT_SMART_PER_MIN=15
ANALYSIS_RATE_LIMIT_JOBS_PER_MIN=15
ANALYSIS_RATE_LIMIT_JOB_STATUS_PER_MIN=90
ANALYSIS_RATE_LIMIT_BARCODE_PER_MIN=30
AUTH_RATE_LIMIT_ENABLED=1
AUTH_RATE_LIMIT_BACKEND=auto
AUTH_RATE_LIMIT_TABLE=auth_rate_limit_events
AUTH_RATE_LIMIT_HASH_SECRET=
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_PER_MIN=5
AUTH_RATE_LIMIT_SIGNUP_PER_MIN=3
AUTH_RATE_LIMIT_VERIFICATION_REQUEST_PER_MIN=3
AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_PER_MIN=3
AUTH_RATE_LIMIT_OAUTH_LOGIN_PER_MIN=10
AUTH_RATE_LIMIT_OAUTH_START_PER_MIN=30
AUTH_RATE_LIMIT_OAUTH_CALLBACK_PER_MIN=30
ANALYSIS_INFLIGHT_GUARD_ENABLED=1
ANALYSIS_INFLIGHT_MAX_ANALYZE=3
ANALYSIS_INFLIGHT_MAX_LABEL=3
ANALYSIS_INFLIGHT_MAX_SMART=3
ANALYSIS_INFLIGHT_MAX_JOBS=3
ANALYSIS_INFLIGHT_MAX_BARCODE=6
ANALYSIS_INFLIGHT_RETRY_AFTER_SECONDS=2
ANALYSIS_JOB_EMBEDDED_WORKER_ENABLED=0
ANALYSIS_CORS_ALLOWED_ORIGINS=https://foodlens-2-w1xu.onrender.com,http://localhost:8081,http://localhost:3000,http://127.0.0.1:8081,http://127.0.0.1:3000
ANALYSIS_CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\..+|192\.168\..+|172\.(1[6-9]|2\d|3[0-1])\..+)(:\d+)?$

# --- Google Cloud / Vertex AI ---
GOOGLE_API_KEY=your_google_api_key_here
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# --- External Food Data APIs ---
USDA_API_KEY=your_usda_api_key_here
KOREAN_FDA_API_KEY=your_korean_fda_api_key_here
FATSECRET_CLIENT_ID=your_fatsecret_client_id
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret
DATAGO_API_KEY=your_datago_api_key_here
DATAGO_I2790_API_KEY=your_datago_i2790_api_key_here
PUBLIC_DATA_AUTH_COOLDOWN_SECONDS=900
BARCODE_LOOKUP_CACHE_TTL_SECONDS=604800
BARCODE_LOOKUP_CACHE_MAX_ENTRIES=1000
BARCODE_LOOKUP_CACHE_PATH=/tmp/foodlens_barcode_lookup_cache.json
BARCODE_UPSTREAM_TIMEOUT_SECONDS=10
BARCODE_UPSTREAM_RETRY_COUNT=2
BARCODE_UPSTREAM_RETRY_BACKOFF_SECONDS=0.6
BARCODE_DATAGO_FAILURE_THRESHOLD=2
BARCODE_DATAGO_UNHEALTHY_COOLDOWN_SECONDS=120

# --- Database (Phase 2 Option A: Render + Managed PostgreSQL) ---
# Local Docker development example:
# DATABASE_URL=postgresql://foodlens:foodlens@127.0.0.1:5432/foodlens
# Render production/staging example (sslmode required):
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=
# Auth runtime state backend:
# - memory: current process memory only (default when DATABASE_URL is empty)
# - postgres: persist auth/session/me state in Postgres
# If omitted, backend auto-selects postgres when DATABASE_URL is set.
AUTH_STATE_BACKEND=
AUTH_STATE_TABLE=auth_runtime_state
AUTH_STATE_KEY=default
AUTH_TOKEN_HASH_SECRET=

# --- Auth OAuth Web Bridge (Phase 1) ---
# Render/public base URL used in provider callback registration
AUTH_PUBLIC_BASE_URL=https://foodlens-2-w1xu.onrender.com
# OAuth 앱 return callback에 사용할 Universal Links/App Links origin
# 운영은 이 값을 설정하고 명시 override가 필요하지 않으면 AUTH_APP_ALLOWED_*를 비워둡니다.
AUTH_OAUTH_REDIRECT_BASE_URL=https://foodlens-2-w1xu.onrender.com
# AUTH_OAUTH_REDIRECT_BASE_URL을 Render URL로 쓸 때 backend가 직접 제공하는 앱 링크 association 파일 값입니다.
APP_LINK_IOS_APP_IDS=9ZL3RJ73M7.com.hoihou.foodlens
APP_LINK_ANDROID_PACKAGE_NAME=com.hoihou.foodlens
APP_LINK_ANDROID_SHA256_CERT_FINGERPRINTS=<ANDROID_RELEASE_CERT_SHA256_FINGERPRINT>
# Provider OAuth app credentials (do not expose client_secret in mobile)
AUTH_GOOGLE_CLIENT_ID=your_google_oauth_client_id
AUTH_KAKAO_CLIENT_ID=your_kakao_rest_api_key
AUTH_KAKAO_CLIENT_SECRET=
AUTH_KAKAO_CODE_VERIFY_ENABLED=0
# deep-link return에 허용할 앱 callback입니다. 비워두면 AUTH_OAUTH_REDIRECT_BASE_URL에서 HTTPS callback을 파생합니다.
# 개발 전용 custom scheme 예시:
# AUTH_APP_ALLOWED_REDIRECT_URIS=foodlens://oauth/google-callback,foodlens://oauth/kakao-callback
AUTH_APP_ALLOWED_REDIRECT_URIS=
# Optional provider scopes/prompts
AUTH_GOOGLE_OAUTH_SCOPE=openid email profile
AUTH_GOOGLE_OAUTH_PROMPT=select_account
# 카카오는 앱에 설정하지 않은 동의항목 scope를 요청하면 KOE205를 반환하므로, 콘솔 설정 전에는 비워둡니다.
AUTH_KAKAO_OAUTH_SCOPE=
# 비워두면 AUTH_OAUTH_REDIRECT_BASE_URL에서 HTTPS logout callback을 파생합니다.
# 개발 전용 custom scheme 예시:
# AUTH_APP_ALLOWED_LOGOUT_REDIRECT_URIS=foodlens://oauth/logout-complete
AUTH_APP_ALLOWED_LOGOUT_REDIRECT_URIS=

# --- Media Storage / Render (Phase 4 sync hardening) ---
MEDIA_STORAGE_BACKEND=gcs
MEDIA_GCS_BUCKET=your_media_bucket_name
MEDIA_GCS_PREFIX=media
MEDIA_MAX_UPLOAD_MB=10
MEDIA_PUBLIC_BASE_URL=https://foodlens-2-w1xu.onrender.com
MEDIA_RENDER_SIGNING_SECRET=
MEDIA_RENDER_URL_TTL_SECONDS=86400
MEDIA_RENDER_ALLOWED_WIDTHS=128,256,512,1024
MEDIA_RENDER_QUALITY_MIN=50
MEDIA_RENDER_QUALITY_MAX=85
MEDIA_RENDER_DEFAULT_WIDTH=512
MEDIA_RENDER_DEFAULT_QUALITY=75

# --- Label Rollout Control ---
LABEL_ROLLOUT_PERCENTAGE=100
LABEL_ROLLOUT_AUTO_ENABLED=1
LABEL_ROLLOUT_PROMOTE_AFTER_PASSES=3
LABEL_ROLLOUT_STATE_BACKEND=file
LABEL_ROLLOUT_STATE_PATH=/tmp/foodlens_rollout_state.json

# --- Label Cost Guardrail ---
LABEL_COST_GUARDRAIL_ENABLED=1
AI_COST_GUARDRAIL_ENABLED=1
AI_COST_GUARDRAIL_STORAGE_BACKEND=memory
AI_COST_GUARDRAIL_USAGE_TABLE=ai_monthly_usage
AI_COST_GUARDRAIL_RESERVATION_TABLE=ai_monthly_usage_reservations
LABEL_COST_GUARDRAIL_STORAGE_BACKEND=memory
LABEL_COST_GUARDRAIL_USAGE_TABLE=label_monthly_usage
LABEL_COST_GUARDRAIL_RESERVATION_TABLE=label_monthly_usage_reservations
AI_MONTHLY_BUDGET_USD=10.0
LABEL_MONTHLY_BUDGET_USD=10.0
FOOD_ESTIMATED_COST_USD_PER_REQUEST=0.006
FOOD_ESTIMATED_TOKENS_PER_REQUEST=2500
SMART_ROUTER_ESTIMATED_COST_USD_PER_REQUEST=0.001
SMART_ROUTER_ESTIMATED_TOKENS_PER_REQUEST=300
LABEL_ESTIMATED_COST_USD_PER_REQUEST=0.02
LABEL_ESTIMATED_COST_USD_PER_REQUEST_FALLBACK=0.02
LABEL_ESTIMATED_COST_USD_PER_REQUEST_PRO_FALLBACK=0.12
LABEL_PRO_FALLBACK_MIN_COST_MULTIPLIER=6
LABEL_ESTIMATED_TOKENS_PER_REQUEST=1500
BARCODE_ALLERGEN_ESTIMATED_COST_USD_PER_REQUEST=0.001
BARCODE_ALLERGEN_ESTIMATED_TOKENS_PER_REQUEST=500

# --- Data Retention ---
RETENTION_ORIGINAL_TTL_DAYS=30
RETENTION_DERIVED_TTL_DAYS=90
RETENTION_LOG_TTL_DAYS=14
ANALYSIS_JOBS_TTL_SCRUB_ENABLED=0
ANALYSIS_JOBS_TTL_SCRUB_DRY_RUN=1
ANALYSIS_JOBS_TTL_SCRUB_DAYS=30
ANALYSIS_JOBS_TTL_SCRUB_BATCH_SIZE=100
RETENTION_STORE_BACKEND=file
RETENTION_STORE_PATH=/tmp/foodlens_retention_store.json
RETENTION_DELETE_BACKEND=noop
DELETION_QUEUE_BACKEND=file
DELETION_QUEUE_PATH=/tmp/foodlens_deletion_queue.json
DELETION_QUEUE_RETRY_MAX_ATTEMPTS=5
DELETION_QUEUE_RETRY_BASE_DELAY_SECONDS=60
DELETION_QUEUE_RETRY_MAX_DELAY_SECONDS=3600

# --- Sentry (Error Tracking) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
