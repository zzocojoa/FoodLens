BASE_URL="https://<render-backend-base-url>"
AUTH_BEARER_TOKEN="<fresh-auth-bearer-token>"
PERF_AUTH_EMAIL=""
PERF_AUTH_PASSWORD=""
# PERF_AUTH_EMAIL/PASSWORD가 비어 있으면 FoodLens/.env.maestro.local의 FOODLENS_E2E_EMAIL/PASSWORD를 사용한다.
MEDIA_RENDER_URL="https://<render-backend-base-url>/media/render/<warmed-asset-id>?exp=<exp>&sig=<sig>"
MEDIA_RENDER_CACHE_MISS_URLS_PATH="/absolute/secure/path/media-render-cache-miss-urls.txt"
ANALYZE_PATH="/absolute/path/to/analyze-fixture.jpg"
K6_MATRIX_VUS="20 50 100"
K6_DURATION="60s"
THINK_TIME_MS="200"
RENDER_CACHE_MISS_EVERY="1"
ANALYZE_EVERY="10"
ANALYZE_LOCALE="ko-KR"
ANALYZE_ALLERGY="egg"
