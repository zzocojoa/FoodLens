# FoodLens Frontend — Environment Variables
# Copy this file as .env and fill in values. DO NOT commit .env.
# Related docs paths:
# - docs/roadmap/cloud-decision-record.md
# - docs/roadmap/phase-2-cloud-db-execution.md
# - docs/ops/db-cutover-local-to-render-postgres.md

# ── Backend Server URL ──────────────────────────────────────────
# Device release test with local backend:
# EXPO_PUBLIC_ANALYSIS_SERVER_URL=http://<your-mac-lan-ip>:8000
# (URL change in release build requires rebuild)
EXPO_PUBLIC_ANALYSIS_SERVER_URL=https://foodlens-2-w1xu.onrender.com

# ── OAuth (Phase 1, mock-first) ─────────────────────────────────
# mock: local QA without real provider console config
# live: use provider web OAuth bridge via backend /auth/{provider}/start
EXPO_PUBLIC_AUTH_OAUTH_MODE=mock
EXPO_PUBLIC_AUTH_GOOGLE_START_URL=https://foodlens-2-w1xu.onrender.com/auth/google/start
EXPO_PUBLIC_AUTH_KAKAO_START_URL=https://foodlens-2-w1xu.onrender.com/auth/kakao/start
EXPO_PUBLIC_AUTH_GOOGLE_LOGOUT_START_URL=https://foodlens-2-w1xu.onrender.com/auth/google/logout/start
EXPO_PUBLIC_AUTH_KAKAO_LOGOUT_START_URL=https://foodlens-2-w1xu.onrender.com/auth/kakao/logout/start
# Set to 1 only when you need forced /me write probe logs in Render (Phase 2 evidence runs).
EXPO_PUBLIC_PHASE2_FORCE_WRITE_PROBE=0
# Photo / smart analyze timeout (ms). /analyze and /analyze/smart only.
EXPO_PUBLIC_AI_ANALYZE_TIMEOUT_MS=30000
EXPO_PUBLIC_AI_CACHE_TTL_SECONDS=86400

# ── Sentry Error Tracking (optional) ───────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
EXPO_PUBLIC_SENTRY_DSN=

# ⚠️ DO NOT add API keys here. All API calls go through the backend.
